{
  "name": "lexnote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LexNote — assistant de prise de notes pour les cours magistraux (local-first, PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
